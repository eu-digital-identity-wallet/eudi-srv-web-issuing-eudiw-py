{
   "eu.webuildconsortium.iban_ov_sd_jwt": {
      "format": "dc+sd-jwt",
      "vct": "eu.we-build:iban-ov:1",
      "scope": "eu.webuildconsortium.iban_ov_sd_jwt",
      "cryptographic_binding_methods_supported": [
         "jwk"
      ],
      "credential_signing_alg_values_supported": [
         "ES256"
      ],
      "proof_types_supported": {
         "jwt": {
            "proof_signing_alg_values_supported": [
               "ES256"
            ]
         }
      },
      "credential_metadata": {
         "display": [
            {
               "name": "IBAN Ownership Verification",
               "locale": "en",
               "description": "Verified proof that an IBAN is owned by a designated legal entity or sole trader.",
               "logo": {
                  "uri": "https://issuer.bank.example/assets/logo.png",
                  "alt_text": "IBAN Ownership Verification logo"
               }
            }
         ],
         "claims": [
            {
               "path": [
                  "bank_account"
               ],
               "mandatory": true,
               "value_type": "bank_account_attributes",
               "source": "user",
               "display": [
                  {
                     "name": "Bank Account",
                     "locale": "en"
                  }
               ],
               "issuer_conditions": {
                  "cardinality": {
                     "min": 1,
                     "max": 1
                  }
               }
            },
            {
               "path": [
                  "bank_account",
                  "account_name"
               ],
               "mandatory": true,
               "value_type": "string",
               "source": "user",
               "display": [
                  {
                     "name": "Account Name",
                     "locale": "en"
                  }
               ]
            },
            {
               "path": [
                  "bank_account",
                  "iban"
               ],
               "mandatory": true,
               "value_type": "string",
               "source": "user",
               "display": [
                  {
                     "name": "IBAN",
                     "locale": "en"
                  }
               ],
               "issuer_conditions": {
                  "pattern": "^[A-Z]{2}[0-9A-Z]{13,30}$"
               }
            },
            {
               "path": [
                  "bank_account",
                  "account_type"
               ],
               "mandatory": true,
               "value_type": "string",
               "source": "user",
               "display": [
                  {
                     "name": "Account Type",
                     "locale": "en"
                  }
               ],
               "issuer_conditions": {
                  "options": [
                     "CURRENT",
                     "SAVINGS",
                     "BASIC",
                     "LOAN",
                     "OTHER"
                  ]
               }
            },
            {
               "path": [
                  "bank_account",
                  "account_currency"
               ],
               "mandatory": true,
               "value_type": "list_string",
               "source": "user",
               "issuer_conditions": {
                  "cardinality": {
                     "min": 1,
                     "max": "n"
                  },
                  "pattern": "^[A-Z]{3}$"
               },
               "display": [
                  {
                     "name": "Account Currency",
                     "locale": "en"
                  }
               ]
            },
            {
               "path": [
                  "account_ownership"
               ],
               "mandatory": true,
               "value_type": "account_ownership_attributes",
               "source": "user",
               "display": [
                  {
                     "name": "Account Ownership",
                     "locale": "en"
                  }
               ],
               "issuer_conditions": {
                  "cardinality": {
                     "min": 1,
                     "max": 1
                  }
               }
            },
            {
               "path": [
                  "account_ownership",
                  "owner_type"
               ],
               "mandatory": true,
               "value_type": "string",
               "source": "user",
               "display": [
                  {
                     "name": "Owner Type",
                     "locale": "en"
                  }
               ],
               "issuer_conditions": {
                  "options": [
                     "entity",
                     "person"
                  ]
               }
            },
            {
               "path": [
                  "account_ownership",
                  "owner_name"
               ],
               "mandatory": false,
               "value_type": "string",
               "source": "user",
               "display": [
                  {
                     "name": "Owner Name",
                     "locale": "en"
                  }
               ],
               "issuer_conditions": {
                  "used_if": {
                     "attribute": "owner_type",
                     "values": [
                        "entity"
                     ]
                  }
               }
            },
            {
               "path": [
                  "account_ownership",
                  "legal_person_identifiers"
               ],
               "mandatory": false,
               "value_type": "identifier_attributes",
               "source": "user",
               "issuer_conditions": {
                  "cardinality": {
                     "min": 1,
                     "max": "n"
                  },
                  "identifier_attributes": {
                     "type": {
                        "mandatory": true,
                        "value_type": "string",
                        "source": "user"
                     },
                     "value": {
                        "mandatory": true,
                        "value_type": "string",
                        "source": "user"
                     }
                  },
                  "used_if": {
                     "attribute": "owner_type",
                     "values": [
                        "entity"
                     ]
                  }
               },
               "display": [
                  {
                     "name": "Owner Legal Person Identifiers",
                     "locale": "en"
                  }
               ]
            },
            {
               "path": [
                  "account_ownership",
                  "legal_person_identifiers",
