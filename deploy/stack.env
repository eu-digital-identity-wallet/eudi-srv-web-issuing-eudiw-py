# Non-secret deploy configuration, committed so it is reviewable in a diff.
# Secrets are repository secrets, listed in deploy/README.md.

ISSUER_HOST=demo.eudiw.grnet.gr

# Paths on the one hostname that exists. No DNS records have been created, so
# every service shares demo.eudiw.grnet.gr and is told apart by prefix.
ISSUER_PATH=/issuer/
# Nested under the issuer, which upstream assumed until 0.10.0 and which
# wallets and the edge's discovery rules now know. nginx picks the longest
# prefix, so this wins over ISSUER_PATH. Was /auth/ until 2026-09-24. Since the
# OIDC server's 0.10.0 the prefix is no longer stripped: the server serves every
# route under the path of its domain.
OIDC_PATH=/issuer/oidc/
# The OIDC server's {domain}: host and path, no scheme. Its issuer is
# https://{domain}, and each frontend's issuer https://{domain}/<frontend id>.
OIDC_DOMAIN=${ISSUER_HOST}/issuer/oidc

# What the issuer publishes. Every absolute URL it emits is this plus a path,
# and it rewrites its own metadata at startup by substituting this for the
# credential_issuer value baked into app/metadata_config/*.json. No trailing
# slash: the code concatenates "/..." onto it.
ISSUER_PUBLIC_URL=https://demo.eudiw.grnet.gr/issuer

# Two URLs for the authorization server, on purpose.
#
# base_url is where the browser is redirected and what appears in published
# metadata, so it has to resolve from outside.
#
# internal_url is the issuer's server-to-server hop for /introspection,
# /preauth_generate and the server's keys (app/services/auth_server.py). Plain
# http and a container name: the OIDC server has no TLS and serves http, so this
# cannot be https. Without it the issuer would dial its own public URL and go
# out through the proxy and back. With the path, which the server serves under.
OIDC_PUBLIC_URL=https://${ISSUER_HOST}/issuer/oidc
OIDC_INTERNAL_URL=http://oidc:5000/issuer/oidc

# The wallet provider's keys. The deploy reads its certificate from here and
# the OIDC server trusts it for wallet attestations, but only without a wallet
# providers list.
WALLET_PROVIDER_JWKS_URL=https://${ISSUER_HOST}/wallet-provider/jwks

# The wallet providers list the OIDC server trusts wallet attestations through,
# the Commission's (ETSI TS 119 602). For the testbed's negative cases, deploy
# with its _empty copy (wallet-providers_empty.json) instead.
WALLET_PROVIDERS_LOTE_URL=https://development.trust.tech.ec.europa.eu/lists/eudiw/wallet-providers.json

# Our frontend, deployed from eudi-srv-web-issuing-frontend-eudiw-py. It is a
# distinct credential issuer identity: the backend signs metadata on its behalf,
# keyed by the frontend_id in frontends_config.
FRONTEND_PUBLIC_URL=https://demo.eudiw.grnet.gr/frontend
# Its frontend_id: frontend.default in the issuer config, and the one entry of
# the OIDC server's frontends. Must match frontend_id in the frontend's config.
FRONTEND_ID=5d725b3c-6d42-448e-8bfd-1eff1fcf152d

# The containerised status list, on 443 with no port.
STATUSLIST_PUBLIC_URL=https://demo.eudiw.grnet.gr

# Our verifier, deployed from eudi-srv-verifier-endpoint. Credentials under
# PID_login in credential_auth_methods ask the wallet for a PID through it. The
# intended use must be one it is configured with: VERIFIER_INTENDED_USE_ID in
# that repository's deploy/stack.env, listed at <verifier>/ui/intended-uses.
VERIFIER_PUBLIC_URL=https://${ISSUER_HOST}/verifier
VERIFIER_INTENDED_USE_ID=1

# The third-party OpenID Connect provider behind the GR country, which issues
# PIDs from its userinfo claims. The issuer appends /.well-known/... to the
# base URL, so this is the host root, not the /oidc/openid-configuration copy
# of the same metadata.
# The client must have ${ISSUER_PUBLIC_URL}/dynamic/redirect registered at the
# provider as a redirect URI. Its secret is the repository secret
# GR_OIDC_CLIENT_SECRET.
GR_OIDC_BASE_URL=https://snf-74864.ok-kno.grnetcloud.net
GR_OIDC_CLIENT_ID=eudiw_login

LETSENCRYPT_EMAIL=devops-rnd@grnet.gr

# Where the CRL is served. Not free to change: the IACA's crlDistributionPoints
# names http://<host>/revocation/crl.pem, and that is signed into the root and
# every certificate chaining to it. The edge's plain-http exception in
# eudi-srv-wallet-provider matches the same path.
CRL_PATH=/revocation/

# Where the IACA is published for partners to download. https only: the edge's
# plain-http exception covers CRL_PATH and nothing else, so this redirects like
# every other path. Kept apart from /revocation/ so a trust anchor does not look
# like revocation data, or come over plain http.
PKI_PATH=/pki/

# No key path here on purpose: pki-init writes the document signer
# (DS_KEY_PEM, DS_CERT_PEM) into a named volume.
