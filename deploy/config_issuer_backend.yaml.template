# Template for config_issuer_backend.yaml, rendered at deploy time.
#
# Upstream's app/config_issuer_backend_example.yaml with the deployment-specific
# values turned into placeholders. The Deploy workflow runs envsubst
# over it and passes the result to compose, which mounts it at
# /app/config_issuer_backend.yaml. Nothing is written to the box.
#
# Safe to commit: the two real secrets, STATUSLIST_API_KEY and DATABASE_PASSWORD,
# are placeholders filled from repository secrets. The `client_secret: "example"`
# values below are upstream's own placeholders for eIDAS node connections we do
# not use; they would become secrets if those are ever enabled.

# ============================================================================
# SERVICE CONFIGURATION
# ============================================================================
service_url: "${ISSUER_PUBLIC_URL}"

wallet_tester_url: "${ISSUER_PUBLIC_URL}"

revocation:
  take_url: "${STATUSLIST_PUBLIC_URL}/token_status_list/take"
  set_url: "${STATUSLIST_PUBLIC_URL}/token_status_list/set"
  api_key: "${STATUSLIST_API_KEY}"
  enabled: true

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================
frontend:
  default: "5d725b3c-6d42-448e-8bfd-1eff1fcf152d"

  frontends_config:
    "5d725b3c-6d42-448e-8bfd-1eff1fcf152d":
      url: "${FRONTEND_PUBLIC_URL}"
      # Upstream's example points these at a path on its own dev machine.
      # From pki-init: the registrar's WRPAC when the deploy provides one,
      # otherwise a copy of GRNET's document signer.
      metadata_signing_key_path: "/etc/eudiw/pid-issuer-dev/wrp/signing.key"
      metadata_access_certificate_path: "/etc/eudiw/pid-issuer-dev/wrp/signing.pem"
      metadata_signing_key_password: null
      # The registrar's WRPRC, published as issuer_info. Empty when the deploy
      # provides none, and the app then leaves issuer_info out.
      registration_certificate_path: "/etc/eudiw/pid-issuer-dev/wrp/registration.jwt"

# ============================================================================
# ISSUER AUTHORIZATION SERVER CONFIGURATION
# ============================================================================

authorization_server:
  base_url: "${OIDC_PUBLIC_URL}"
  internal_url: "${OIDC_INTERNAL_URL}"
  # Public: the issuer redirects the browser here after the form.
  user_verify_endpoint: "${OIDC_PUBLIC_URL}/verify/user"

# ============================================================================
# EXTERNAL SERVICES CONFIGURATION
# ============================================================================
#verifier url for oid4vp request generation, available at https://github.com/eu-digital-identity-wallet/eudi-srv-verifier-endpoint
# Ours, not the EU's: see VERIFIER_PUBLIC_URL in stack.env.
dynamic_presentation_url: "${VERIFIER_PUBLIC_URL}/ui/presentations"
# at least one of 'intended_use_id' or 'registration_certificate_jwt' must be defined
intended_use_id: "${VERIFIER_INTENDED_USE_ID}"
registration_certificate_jwt:

# WUA trust validator url, available at https://github.com/eu-digital-identity-wallet/eudi-srv-trust-validator
# Both off: EU's validators reject our wallet provider's and status list's
# certificates. Until we run our own, see deploy/README.md, "Still to sort".
trust_validator:
  url: "https://trust-validator.eudiw.dev/trust"
  enabled: false

status_validator:
  url: "https://status-validator.issuer.eudiw.dev/status"
  enabled: false

# ============================================================================
# SCHEMA CONFIGURATION
# ============================================================================
oid4vp_scheme: "haip-vp://"

credential_offer_scheme: "haip-vci://"

# ============================================================================
# POSTGRES CONFIGURATION
# ============================================================================
postgres:
  host: "postgres"
  port: 5432
  dbname: "${DATABASE_NAME}"
  user: "${DATABASE_USER}"
  password: "${DATABASE_PASSWORD}"

# ============================================================================
# LOGGING
# ============================================================================
logging:
  backend_path: "/tmp/log_prod/logs.log"
  log_level: "INFO"

# ============================================================================
# EXPIRY TIMES (minutes)
# ============================================================================
expiry:
  revocation_code: 60
  form: 60
  session: 60

# ============================================================================
# KEY PATHS
# ============================================================================
keys:
  nonce_path: "/etc/eudiw/pid-issuer-dev/privKey/nonce_rsa2048.pem" # Private key that signs the nonce at the nonce enpoint.
  credential_request_path: "/etc/eudiw/pid-issuer-dev/privKey/credential_request.pem" # Private key used for credential request encryption. Metadata advertised public key is automatically generated from this private key.

# Path to trusted CA certificates, used to validate VP_Tokens
trusted_CAs_path: "/etc/eudiw/pid-issuer-dev/cert/"

# ============================================================================
# CREDENTIALS AUTHENTICATION METHODS CONFIGURATION
# ============================================================================
credential_auth_methods:
  PID_login:
    - eu.europa.ec.eudi.pseudonym_over18_mdoc
    - eu.europa.ec.eudi.pseudonym_over18_mdoc_deferred_endpoint
    - eu.europa.ec.eudi.por_mdoc
    - eu.europa.ec.eudi.iban_mdoc
    - eu.europa.ec.eudi.hiid_mdoc
    - eu.europa.ec.eudi.tax_mdoc
    - eu.europa.ec.eudi.msisdn_mdoc

  country_selection:
    - eu.europa.ec.eudi.loyalty_mdoc
    - eu.europa.ec.eudi.mdl_mdoc
    - eu.europa.ec.eudi.pid_vc_sd_jwt
    - eu.europa.ec.eudi.pid_mdoc
    - eu.europa.ec.eudi.pseudonym_over18_mdoc
    - eu.europa.ec.eudi.pseudonym_over18_mdoc_deferred_endpoint
    - eu.europa.ec.eudi.photoid
    - eu.europa.ec.eudi.por_mdoc
    - eu.europa.ec.eudi.iban_mdoc
    - eu.europa.ec.eudi.hiid_mdoc
    - eu.europa.ec.eudi.tax_mdoc
    - eu.europa.ec.eudi.msisdn_mdoc
    - eu.europa.ec.eudi.ehic_mdoc
    - eu.europa.ec.eudi.pda1_mdoc
    - eu.europa.ec.eudi.tax_sd_jwt_vc
    - eu.europa.ec.eudi.por_sd_jwt_vc
    - eu.europa.ec.eudi.msisdn_sd_jwt_vc
    - eu.europa.ec.eudi.hiid_sd_jwt_vc
    - eu.europa.ec.eudi.iban_sd_jwt_vc
    - eu.europa.ec.eudi.pseudonym_over18_sd_jwt_vc
    - eu.europa.ec.eudi.cor_mdoc
    - eu.europa.ec.eudi.pda1_sd_jwt_vc
    - eu.europa.ec.eudi.ehic_sd_jwt_vc
    - org.iso.18013.5.1.reservation_mdoc
    - eu.europa.ec.eudi.seafarer_mdoc
    - eu.europa.ec.eudi.diploma_vc_sd_jwt
    - eu.europa.ec.eudi.tax_residency_vc_sd_jwt
    - eu.europa.ec.eudi.employee_mdoc
    - eu.europa.ec.eudi.pid_mdoc_deferred
    - eu.europa.ec.eudi.age_verification_mdoc
    - eu.europa.ec.eudi.age_verification_mdoc_passport
    - eu.europa.ec.eudi.learning_credential_vc_sd_jwt
    # WE BUILD SCA attestations, here to provision test cards for the PA2
    # payment demo through the form. The rulebooks (rb-sca-card-dpc 4.1) want
    # issuance only after a PID presentation, i.e. PID_login only, but that
    # path needs a verifier our wallet trusts, and the demo itself issues
    # nothing: its cards are pre-loaded.
    - eu.webuildconsortium.sca.user_mdoc
    - eu.webuildconsortium.sca.card_dpc_sd_jwt

# ============================================================================
# COUNTRIES CONFIGURATION
# ============================================================================

# Currently only _default is supported for both keys and custom_modifiers
# Eventually keys will be separated by frontend and custom_modifiers per credential_configuration_id
#
# Every country signs with GRNET's document signer, except SD-JWT VC PIDs when
# the deploy provides pid_sd_jwt: GRNET's WE BUILD-onboarded certificate, the one
# on the Commission's PID providers list (pki-init.sh lays it out in ds-pid/).
# Connection types supported: oauth or openid

countries:
  EU:
    name: "nodeEU"

    # Keys and certificates
    keys:
      _default:
        private_key_path: "/etc/eudiw/pid-issuer-dev/ds/signing.key"
        private_key_password: null
        certificate_path: "/etc/eudiw/pid-issuer-dev/ds/signing.der"
      pid_sd_jwt:
        optional: true
        private_key_path: "/etc/eudiw/pid-issuer-dev/ds-pid/signing.key"
        private_key_password: null
        certificate_path: "/etc/eudiw/pid-issuer-dev/ds-pid/signing.der"

    supported_credential_ids:
      - "eu.europa.ec.eudi.pid_mdoc"
      - "eu.europa.ec.eudi.pid_vc_sd_jwt"
      - "eu.europa.ec.eudi.pid_mdoc_deferred"

    custom_modifiers:
      _default:
        family_name: "CurrentFamilyName"
        given_name: "CurrentGivenName"
        birth_date: "DateOfBirth"

    connection_type: "oauth"

    auth:
      base_url: "https://eidas.projj.eu"
      redirect_uri: "https://backend.issuer.eudiw.dev/dynamic/redirect"
      scope: "profile"
      response_type: "code"
      client_id: "example"
      client_secret: "example"

  FC:
    name: "FormEU"
    keys:
      _default:
        private_key_path: "/etc/eudiw/pid-issuer-dev/ds/signing.key"
        private_key_password: null
        certificate_path: "/etc/eudiw/pid-issuer-dev/ds/signing.der"
      pid_sd_jwt:
        optional: true
        private_key_path: "/etc/eudiw/pid-issuer-dev/ds-pid/signing.key"
        private_key_password: null
        certificate_path: "/etc/eudiw/pid-issuer-dev/ds-pid/signing.der"

    un_distinguishing_sign: "FC"

    supported_credential_ids:
      - "eu.europa.ec.eudi.pid_mdoc"
      - "eu.europa.ec.eudi.pid_vc_sd_jwt"
      - "eu.europa.ec.eudi.mdl_mdoc"
      - "eu.europa.ec.eudi.over18_mdoc"
      - "eu.europa.ec.eudi.loyalty_mdoc"
      - "eu.europa.ec.eudi.photoid"
      - "eu.europa.ec.eudi.por_mdoc"
      - "eu.europa.ec.eudi.iban_mdoc"
      - "eu.europa.ec.eudi.hiid_mdoc"
      - "eu.europa.ec.eudi.tax_mdoc"
      - "eu.europa.ec.eudi.msisdn_mdoc"
      - "eu.europa.ec.eudi.pda1_mdoc"
      - "eu.europa.ec.eudi.tax_sd_jwt_vc"
      - "eu.europa.ec.eudi.por_sd_jwt_vc"
      - "eu.europa.ec.eudi.msisdn_sd_jwt_vc"
      - "eu.europa.ec.eudi.hiid_sd_jwt_vc"
      - "eu.europa.ec.eudi.iban_sd_jwt_vc"
      - "eu.europa.ec.eudi.ehic_mdoc"
      - "eu.europa.ec.eudi.cor_mdoc"
      - "eu.europa.ec.eudi.ehic_sd_jwt_vc"
      - "eu.europa.ec.eudi.pda1_sd_jwt_vc"
      - "org.iso.18013.5.1.reservation_mdoc"
      - "eu.europa.ec.eudi.seafarer_mdoc"
      - "eu.europa.ec.eudi.diploma_vc_sd_jwt"
      - "eu.europa.ec.eudi.tax_residency_vc_sd_jwt"
      - "eu.europa.ec.eudi.employee_mdoc"
      - "eu.europa.ec.eudi.pid_mdoc_deferred"
      - "eu.europa.ec.eudi.learning_credential_vc_sd_jwt"
      # WE BUILD SCA attestations, see credential_auth_methods
      - "eu.webuildconsortium.sca.user_mdoc"
      - "eu.webuildconsortium.sca.card_dpc_sd_jwt"


  PT:
    name: "Portugal"

    keys:
      _default:
        private_key_path: "/etc/eudiw/pid-issuer-dev/ds/signing.key"
        private_key_password: null
        certificate_path: "/etc/eudiw/pid-issuer-dev/ds/signing.der"
      pid_sd_jwt:
        optional: true
        private_key_path: "/etc/eudiw/pid-issuer-dev/ds-pid/signing.key"
        private_key_password: null
        certificate_path: "/etc/eudiw/pid-issuer-dev/ds-pid/signing.der"

    un_distinguishing_sign: "P"

    supported_credential_ids:
      - "eu.europa.ec.eudi.pid_mdoc"
      - "eu.europa.ec.eudi.pid_vc_sd_jwt"
      - "eu.europa.ec.eudi.mdl_mdoc"
      - "eu.europa.ec.eudi.pid_mdoc_deferred"

    connection_type: "oauth"

    custom_modifiers:
      _default:
        "http://interop.gov.pt/MDC/Cidadao/DataNascimento": "birth_date"
        "http://interop.gov.pt/MDC/Cidadao/NomeApelido": "family_name"
        "http://interop.gov.pt/MDC/Cidadao/NomeProprio": "given_name"

    auth:
      base_url: "https://country-connector.ageverification.dev"
      redirect_uri: "https://backend.issuer.eudiw.dev/dynamic/redirect"
      scope: "profile"
      response_type: "code"
      client_id: "example"
      client_secret: "example"

  EE:
    name: "Estonia"

    keys:
      _default:
        private_key_path: "/etc/eudiw/pid-issuer-dev/ds/signing.key"
        private_key_password: null
        certificate_path: "/etc/eudiw/pid-issuer-dev/ds/signing.der"
      pid_sd_jwt:
        optional: true
        private_key_path: "/etc/eudiw/pid-issuer-dev/ds-pid/signing.key"
        private_key_password: null
        certificate_path: "/etc/eudiw/pid-issuer-dev/ds-pid/signing.der"

    supported_credential_ids:
      - "eu.europa.ec.eudi.pid_mdoc"
      - "eu.europa.ec.eudi.pid_vc_sd_jwt"

    connection_type: "openid"

    auth:
      base_url: "https://tara-test.ria.ee"
      redirect_uri: "https://pprpid.provider.eudiw.projj.eu/tara/redirect"
      scope: "openid"
      response_type: "code"
      grant_type: "authorization_code"
      client_id: "eu_europa_ec_eudiw_pid_provider_1_ppr"
      client_secret: "Basic example=="
      authorization_headers: {"Host": "tara-test.ria.ee"}
      token_endpoint_headers: {"Host": "tara-test.ria.ee", "Content-Type": "application/x-www-form-urlencoded"}

    custom_modifiers:
      _default:
        family_name: "CurrentFamilyName"
        given_name: "CurrentGivenName"
        birth_date: "date_of_birth"
